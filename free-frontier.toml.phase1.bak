# Phase 1 configuration: one logical model -> one physical free route.
# Phase 2 will add multiple routes, fallback, and cooldowns.

[server]
host = "127.0.0.1"
port = 4000

[routes."gemini-flash"]
provider = "gemini"
model = "gemini/gemini-3.6-flash"
enabled = true
free = true
api_key_env = "GEMINI_API_KEY"

[logical_models."free-frontier"]
routes = ["gemini-flash"]
