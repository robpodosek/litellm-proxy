# Free Frontier provider credentials
#
# Copy this file to .env and fill in ONLY the providers you enable in
# free-frontier.toml.
#
# IMPORTANT: Free Frontier controls which configured routes it knowingly selects.
# It cannot override billing settings on an upstream provider account. If strict
# zero-cost operation matters, configure provider accounts/projects so paid overages
# are disabled or otherwise impossible where supported.

GEMINI_API_KEY=
GROQ_API_KEY=

# Reserved for later provider configurations.
NVIDIA_NIM_API_KEY=
OPENROUTER_API_KEY=
