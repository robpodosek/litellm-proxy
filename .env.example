# LiteLLM Proxy Credentials
# Rename this file to .env and fill in your keys

# UI Login Credentials
# IMPORTANT: LITELLM_MASTER_KEY must start with 'sk-'
LITELLM_MASTER_KEY=sk-free-frontier-1234
LITELLM_UI_PASSWORD=admin123

# Cloud Providers

# Google AI Studio (https://aistudio.google.com/app/apikey)
# Free tier: Gemini 3 Flash, Gemini 3.1 Flash-Lite (no billing account required)
GEMINI_API_KEY=your_gemini_api_key

# Groq Cloud (https://console.groq.com/keys)
# Free tier: Llama 4 Maverick, Qwen3-32B, and more (rate-limited)
GROQ_API_KEY=your_groq_api_key

# OpenRouter (https://openrouter.ai/keys)
# Free tier: Models with :free suffix are fully subsidized
OPENROUTER_API_KEY=your_openrouter_api_key

# NVIDIA NIM (https://build.nvidia.com/)
# Free tier: Kimi K2.6, DeepSeek V4 Pro, and 100+ models (rate-limited)
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key
