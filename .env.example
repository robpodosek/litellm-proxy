# Free Frontier provider credentials
#
# Copy this file to .env and fill in ONLY the providers you intend to enable.
# Phase 1's example configuration uses Gemini as its single upstream route.
#
# IMPORTANT: Free Frontier can control which routes it knowingly selects, but it cannot
# override billing settings on your upstream provider accounts. If you require strict
# zero-cost operation, configure each provider account/project so paid overages are
# disabled or otherwise impossible where supported.

# Phase 1 example route
GEMINI_API_KEY=

# Reserved for later phases / alternative configurations
GROQ_API_KEY=
NVIDIA_NIM_API_KEY=
OPENROUTER_API_KEY=
